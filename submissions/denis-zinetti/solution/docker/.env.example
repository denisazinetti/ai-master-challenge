# Local: docker compose -f compose.yml -f compose.local.yml up --build
APP_PORT=8080

# VPS: docker compose -f compose.yml -f compose.vps.yml up -d --build
APP_HOST=g4desk.example.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional: enables the assisted draft endpoint. The dashboard remains functional without it.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
